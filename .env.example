# ==============================================================================
# ChronoSearch Agent - Environment Configuration
# ==============================================================================
# You only need ONE LLM API key and ONE Search API key (or use DuckDuckGo fallback).
# The agent will automatically detect and configure the available provider.
# ==============================================================================

# --- LLM Providers (Provide at least one) ---
# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (Gemini 2.0 Flash, Gemini 1.5 Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic (Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq (Llama 3.3 70B - fastest inference)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Explicitly choose LLM provider ('openai' | 'gemini' | 'anthropic' | 'groq' | 'auto')
LLM_PROVIDER=auto

# Optional: Specific model name override (e.g. gpt-4o-mini, gemini-2.0-flash, claude-3-5-sonnet-20241022)
LLM_MODEL=auto


# --- Web Search Providers (Optional - Zero-Config Fallback Included) ---
# If no search key is provided, the agent automatically falls back to its built-in
# DuckDuckGo HTML scraper engine with ZERO external API keys needed!

# Tavily AI Search (Recommended for fastest AI search snippets & changelog filtering)
TAVILY_API_KEY=your_tavily_api_key_here

# Brave Search API (Independent web index)
BRAVE_API_KEY=your_brave_api_key_here

# Serper API (Google Search API)
SERPER_API_KEY=your_serper_api_key_here

# Optional: Explicit search provider ('auto' | 'tavily' | 'brave' | 'serper' | 'duckduckgo')
SEARCH_PROVIDER=auto


# --- Server & Agent Configuration ---
PORT=3000
HOST=localhost

# Optional: Maximum parallel search queries per intent (default: 3)
MAX_PARALLEL_SEARCHES=3

# Optional: Deep page scraping timeout in milliseconds (default: 2000)
SCRAPE_TIMEOUT_MS=2000

